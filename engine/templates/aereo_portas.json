      "dimensoes": {
        "altura": "MEDIDA_ALTURA - PARAM_FOLGA_SUPERIOR - PARAM_FOLGA_INFERIOR",
        "largura": "(MEDIDA_LARGURA / CONFIG_QTD_PORTAS) - PARAM_FOLGA_PORTA"
      },
      "fita_borda": { "lados_altura": 2, "lados_largura": 2 }
    }
  ],
  "ferragens": [
    {
      "item": "dobradica_35",
      "quantidade": "CONFIG_QTD_PORTAS * max(2, ceil((MEDIDA_ALTURA - PARAM_FOLGA_SUPERIOR - PARAM_FOLGA_INFERIOR) / 450))"
    },
    { "item": "puxador", "quantidade": "CONFIG_QTD_PORTAS" },
    { "item": "suporte_fixacao_aereo", "quantidade": "2" },
    { "item": "parafuso_kit_modulo", "quantidade": "1" }
  ],
  "participa_elementos_continuos": { "tampo": false, "rodape": false }
