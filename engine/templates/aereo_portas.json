{
  "codigo": "AEREO_PORTAS",
  "versao": 1,
  "nome": "Módulo Aéreo com Portas",
  "categoria": "superior",
  "limites": {
    "largura": { "min": 200, "max": 1200 },
    "altura": { "min": 300, "max": 1000 },
    "profundidade": { "min": 250, "max": 450 }
  },
  "config_padrao": {
    "CONFIG_QTD_PORTAS": 2,
    "CONFIG_QTD_PRATELEIRAS": 1
  },
  "componentes": [
    {
      "nome": "Lateral",
      "quantidade": "2",
      "material_tipo": "caixa",
      "dimensoes": {
        "altura": "MEDIDA_ALTURA",
        "largura": "MEDIDA_PROFUNDIDADE"
      },
      "fita_borda": { "lados_altura": 1, "lados_largura": 2 }
    },
    {
      "nome": "Base",
      "quantidade": "1",
      "material_tipo": "caixa",
      "dimensoes": {
        "altura": "MEDIDA_PROFUNDIDADE",
        "largura": "MEDIDA_LARGURA - 2 * PARAM_ESPESSURA_CAIXA"
      },
      "fita_borda": { "lados_altura": 0, "lados_largura": 1 }
    },
    {
      "nome": "Tampo",
      "quantidade": "1",
      "material_tipo": "caixa",
      "dimensoes": {
        "altura": "MEDIDA_PROFUNDIDADE",
        "largura": "MEDIDA_LARGURA - 2 * PARAM_ESPESSURA_CAIXA"
      },
      "fita_borda": { "lados_altura": 0, "lados_largura": 1 }
    },
    {
      "nome": "Fundo",
      "quantidade": "1",
      "material_tipo": "fundo",
      "dimensoes": {
        "altura": "MEDIDA_ALTURA",
        "largura": "MEDIDA_LARGURA"
      },
      "fita_borda": { "lados_altura": 0, "lados_largura": 0 }
    },
    {
      "nome": "Prateleira",
      "quantidade": "CONFIG_QTD_PRATELEIRAS",
      "material_tipo": "prateleira",
      "dimensoes": {
        "altura": "MEDIDA_PROFUNDIDADE - PARAM_RECUO_PRATELEIRA",
        "largura": "MEDIDA_LARGURA - 2 * PARAM_ESPESSURA_CAIXA"
