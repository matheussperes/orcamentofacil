// Schema do banco (doc 03). NÃO é importado pelo app de demonstração — o MVP
// da engine roda sem banco. Este schema é a base da persistência (Sprint 1):
//   npx prisma migrate dev
// Requer DATABASE_URL (Supabase/Neon) no ambiente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?
  logoUrl   String?
  criadoEm  DateTime @default(now())
  usuarios  Usuario[]
  clientes  Cliente[]
  orcamentos Orcamento[]
  parametros ParametrosFabrica?
}

enum Papel {
  admin
  projetista
  vendedor
  financeiro
}

model Usuario {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  nome     String
  email    String @unique
  papel    Papel  @default(vendedor)

  @@index([tenantId])
}

enum StatusCliente {
  lead
  ativo
  inativo
}

model Cliente {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  nome        String
  telefone    String?
  email       String?
  endereco    String?
  origem      String?
  arquiteto   String?
  observacoes String?
  status      StatusCliente @default(lead)
  orcamentos  Orcamento[]

  @@index([tenantId])
}

enum StatusOrcamento {
  rascunho
  enviado
  negociacao
  aprovado
  perdido
}

model Orcamento {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  clienteId     String
  cliente       Cliente           @relation(fields: [clienteId], references: [id])
  responsavelId String?
  data          DateTime          @default(now())
  validade      DateTime?
  prazoEntrega  DateTime?
  formaPagamento String?
  observacoes   String?
  descontoPct   Decimal           @default(0)
  status        StatusOrcamento   @default(rascunho)
  versaoAtual   Int               @default(1)
  ambientes     Ambiente[]
  versoes       OrcamentoVersao[]

  @@index([tenantId])
  @@index([clienteId])
}

// Snapshot imutável (append-only): entrada + BOM + custos + preço em JSON.
model OrcamentoVersao {
  id          String    @id @default(uuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  numero      Int
  autorId     String?
  motivo      String?
  snapshot    Json
  criadoEm    DateTime  @default(now())

  @@unique([orcamentoId, numero])
  @@index([orcamentoId])
}

model Ambiente {
  id             String              @id @default(uuid())
  orcamentoId    String
  orcamento      Orcamento           @relation(fields: [orcamentoId], references: [id])
  nome           String
  tipo           String
  observacoes    String?
  medidas        Json
  materiaisPadrao Json?
  modulos        ModuloInstanciado[]
}

// Biblioteca de Engenharia — global no MVP (tenantId nulo). Fórmulas em JSON.
model ModuloTemplate {
  id       String              @id @default(uuid())
  codigo   String
  versao   Int                 @default(1)
  nome     String
  categoria String
  formulasJson Json
  limites  Json
  ativo    Boolean             @default(true)
  instancias ModuloInstanciado[]

  @@unique([codigo, versao])
}

model ModuloInstanciado {
  id            String         @id @default(uuid())
  ambienteId    String
  ambiente      Ambiente       @relation(fields: [ambienteId], references: [id])
  templateId    String
  template      ModuloTemplate @relation(fields: [templateId], references: [id])
  parede        String?
  posicao       Int            @default(0)
  larguraMm     Int
  alturaMm      Int
  profundidadeMm Int
  config        Json?
  overridesMaterial Json?
  resultadoBom  Json?

  @@index([ambienteId])
}

model ParametrosFabrica {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  valores  Json
}

// Catálogo → Fornecedor → Preço (doc 07)
model CatalogoItem {
  id        String     @id @default(uuid())
  tenantId  String?
  tipo      String
  marca     String?
  modelo    String?
  descricao String
  atributos Json?
  precos    Preco[]

  @@index([tenantId])
  @@index([tipo])
}

model Fornecedor {
  id        String  @id @default(uuid())
  tenantId  String
  nome      String
  cidade    String?
  prazoDias Int?
  fretePadrao Decimal?
  precos    Preco[]

  @@index([tenantId])
}

model Preco {
  id             String       @id @default(uuid())
  catalogoItemId String
  catalogoItem   CatalogoItem @relation(fields: [catalogoItemId], references: [id])
  fornecedorId   String?
  fornecedor     Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  valor          Decimal
  unidade        String
  vigenciaInicio DateTime     @default(now())
  referencia     Boolean      @default(false)

  @@index([catalogoItemId])
}

model Auditoria {
  id         String   @id @default(uuid())
  entidade   String
  entidadeId String
  acao       String
  diff       Json?
  usuarioId  String?
  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
}
